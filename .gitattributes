# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Unix scripts must keep LF or they fail on macOS / Linux.
mvnw            text eol=lf
*.sh            text eol=lf

# Windows scripts keep CRLF.
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary
*.jar           binary

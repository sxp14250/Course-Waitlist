<?xml version="1.0" encoding="UTF-8"?>
<!--
  CourseWaitlist - enrollment, drop and FIFO waitlist promotion for ONE course offering.

  Build:   mvn clean verify
  Tests:   mvn test
  Run CLI: java -jar target/course-waitlist-1.0.0.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.coursewaitlist</groupId>
    <artifactId>course-waitlist</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CourseWaitlist</name>
    <description>Bounded enrollment / drop / FIFO waitlist-promotion slice for a single course offering.</description>

    <properties>
        <!-- Latest Java release at time of writing (JDK 27). -->
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>6.1.3</junit.version>
        <compiler.plugin.version>3.16.0</compiler.plugin.version>
        <surefire.plugin.version>3.6.1</surefire.plugin.version>
        <jar.plugin.version>3.5.1</jar.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- No runtime dependencies: the slice uses only the JDK. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>
            <plugin>
                <!-- Makes the jar directly runnable: java -jar target/course-waitlist-1.0.0.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.coursewaitlist.cli.WaitlistCli</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
